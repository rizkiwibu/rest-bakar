            <button class="p-2 bg-neutral-100 dark:bg-neutral-800 rounded-full soft-shadow hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-all">
                <i id="theme-icon" class="fas fa-moon dark:fa-sun text-neutral-600 dark:text-neutral-300"></i>
            </button>
        </div>

        <main>
            <section class="text-center mb-10">
                <img 
                    src="https://avatars.githubusercontent.com/u/154863645?v=4" 
                    alt="RIZKI IRFAN" 
                    class="w-24 h-24 mx-auto rounded-full mb-4 object-cover soft-border soft-shadow"
                >
                
                <h1 class="text-2xl font-medium tracking-tight text-neutral-800 dark:text-neutral-200">
                    RIZKI IRFAN
                </h1>
                <p class="text-sm text-neutral-500 dark:text-neutral-400 font-light">
                    Prompt Engineer
                </p>

                <div class="flex justify-center space-x-4 mt-4">
                    <a href="mailto:irfanwibu88@gmail.com" class="text-neutral-400 hover:text-neutral-600 dark:text-neutral-500 dark:hover:text-neutral-300 transition-colors">
                        <i class="fas fa-envelope text-lg"></i>
                    </a>
                    <a href="https://linkedin.com/in/Rizki" class="text-neutral-400 hover:text-neutral-600 dark:text-neutral-500 dark:hover:text-neutral-300 transition-colors">
                        <i class="fab fa-linkedin text-lg"></i>
                    </a>
                    <a href="https://github.com/rizkiwibu" class="text-neutral-400 hover:text-neutral-600 dark:text-neutral-500 dark:hover:text-neutral-300 transition-colors">
                        <i class="fab fa-github text-lg"></i>
                    </a>
                    <a href="https://twitter.com/Rizki" class="text-neutral-400 hover:text-neutral-600 dark:text-neutral-500 dark:hover:text-neutral-300 transition-colors">
                        <i class="fab fa-twitter text-lg"></i>
                    </a>
                </div>
            </section>

            <section class="mb-8">
                <div id="online-identities" class="bg-neutral-50 dark:bg-neutral-800 rounded-lg p-5 soft-shadow soft-border">
                    <h2 class="text-base font-medium mb-3 text-neutral-600 dark:text-neutral-300 border-b border-neutral-200 dark:border-neutral-700 pb-2">
                        Online Identities
                    </h2>
                    <div id="identities-container" class="flex flex-wrap justify-center gap-2"></div>
                </div>
            </section>

            <div class="grid md:grid-cols-2 gap-6">
                <section class="bg-neutral-50 dark:bg-neutral-800 rounded-lg p-5 soft-shadow soft-border">
                    <h2 class="text-base font-medium mb-3 text-neutral-600 dark:text-neutral-300 border-b border-neutral-200 dark:border-neutral-700 pb-2">
                        About
                    </h2>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400 font-light leading-relaxed">
                        Experienced Prompt Engineer passionate about developing intelligent AI systems. 
                        Specializing in crafting effective prompts and optimizing human-AI interactions.
                    </p>
                </section>

                <section class="bg-neutral-50 dark:bg-neutral-800 rounded-lg p-5 soft-shadow soft-border">
                    <h2 class="text-base font-medium mb-3 text-neutral-600 dark:text-neutral-300 border-b border-neutral-200 dark:border-neutral-700 pb-2">
                        Personal Information
                    </h2>
                    <div id="personal-info-container" class="flex flex-wrap gap-2"></div>
                </section>

                <section class="bg-neutral-50 dark:bg-neutral-800 rounded-lg p-5 soft-shadow soft-border">
                    <h2 class="text-base font-medium mb-3 text-neutral-600 dark:text-neutral-300 border-b border-neutral-200 dark:border-neutral-700 pb-2">
                        Skills
                    </h2>
                    <div id="skills-container" class="flex flex-wrap gap-2"></div>
                </section>

                <section class="bg-neutral-50 dark:bg-neutral-800 rounded-lg p-5 soft-shadow soft-border">
                    <h2 class="text-base font-medium mb-3 text-neutral-600 dark:text-neutral-300 border-b border-neutral-200 dark:border-neutral-700 pb-2">
                        Projects
                    </h2>
                    <div id="projects-container" class="flex flex-col gap-2"></div>
                </section>
            </div>
        </main>

        <footer class="text-center text-xs text-neutral-400 dark:text-neutral-500 mt-10">
            © 2024 RIZKI IRFAN
        </footer>
    </div>

    <script>
        const THEME_TOGGLE = document.getElementById('theme-toggle');
        const THEME_ICON = document.getElementById('theme-icon');
        const HTML_ELEMENT = document.documentElement;

        const PERSONAL_INFO_CONTAINER = document.getElementById('personal-info-container');
        const IDENTITIES_CONTAINER = document.getElementById('identities-container');
        const SKILLS_CONTAINER = document.getElementById('skills-container');
        const PROJECTS_CONTAINER = document.getElementById('projects-container');

        function calculateAge(birthDate) {
            const today = new Date();
            const birth = new Date(birthDate);
            let age = today.getFullYear() - birth.getFullYear();
            const m = today.getMonth() - birth.getMonth();
            if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) {
                age--;
            }
            return age;
        }

        const PERSONAL_INFO = [
            { 
                icon: 'fa-birthday-cake', 
                getValue: () => `${calculateAge('2007-11-16')} Year` 
            },            
            { icon: 'fa-globe', text: 'Indonesia' },
            { icon: 'fa-heart', text: 'Single' },
            { icon: 'fa-cat', text: 'Cat Lover' },
            { icon: 'fa-hand-holding-heart', text: 'Kindhearted' },
            { icon: 'fa-user-secret', text: 'Nolep' },
            { icon: 'fa-code', text: 'Coding' },
            { icon: 'fa-wallet', text: 'Empty' }
          ]

        const IDENTITIES = [
            { name: "rizkiwibu", link: "https://github.com/rizkiwibu" }
        ];

        const SKILLS = [
            "Prompt Engineering", "AI Interaction", 
            "Machine Learning", "NLP", "Node Js",
            "Monggodb", "Website scraping"
        ];

        const PROJECTS = [
            {
                name: "ikybot API",
                description: "REST API for multi-purpose services",
                link: "https://restapi.botwaaa.web.id"
            },
            {
                name: "ikybot whastaap",
                description: "bot wa yang bisa download bikin stiker dan lainya",
                link: "https://chat.whatsapp.com/KIcqnzY4NJMHXPTz8Xopvd"
            }
        ];

        function initializeTheme() {
            const savedTheme = localStorage.getItem('theme');
            if (savedTheme) {
                HTML_ELEMENT.classList.toggle('dark', savedTheme === 'dark');
            } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                HTML_ELEMENT.classList.add('dark');
            }
            updateThemeIcon();
        }

        function updateThemeIcon() {
            const isDark = HTML_ELEMENT.classList.contains('dark');
            THEME_ICON.classList.toggle('fa-moon', !isDark);
            THEME_ICON.classList.toggle('fa-sun', isDark);
        }

        function renderPersonalInfo() {
            PERSONAL_INFO.forEach(info => {
                const span = document.createElement('span');
                span.className = 'bg-neutral-200 dark:bg-neutral-700 text-neutral-600 dark:text-neutral-300 px-2 py-1 rounded-md text-xs transition-all hover:bg-neutral-300 dark:hover:bg-neutral-600 inline-flex items-center gap-2';
                
                const icon = document.createElement('i');
                icon.className = `fas ${info.icon} text-neutral-500 dark:text-neutral-400`;
                
                const text = document.createTextNode(
                    info.getValue ? `${info.getValue()}` : info.text
                );
                
                span.appendChild(icon);
                span.appendChild(text);
                PERSONAL_INFO_CONTAINER.appendChild(span);
            });
        }

        function renderIdentities() {
            IDENTITIES.forEach(identity => {
                const a = document.createElement('a');
                a.href = identity.link;
                a.target = "_blank";
                a.className = 'bg-neutral-200 dark:bg-neutral-700 text-neutral-600 dark:text-neutral-300 px-2 py-1 rounded-md text-xs transition-all hover:bg-neutral-300 dark:hover:bg-neutral-600';
                a.textContent = identity.name;
                IDENTITIES_CONTAINER.appendChild(a);
            });
        }

        function renderSkills() {
            SKILLS.forEach(skill => {
                const span = document.createElement('span');
                span.className = 'bg-neutral-200 dark:bg-neutral-700 text-neutral-600 dark:text-neutral-300 px-2 py-1 rounded-md text-xs transition-all hover:bg-neutral-300 dark:hover:bg-neutral-600';
                span.textContent = skill;
                SKILLS_CONTAINER.appendChild(span);
            });
        }

        function renderProjects() {
            PROJECTS.forEach(project => {
                const div = document.createElement('div');
                div.className = 'bg-neutral-200 dark:bg-neutral-700 text-neutral-600 dark:text-neutral-300 p-3 rounded-md text-xs transition-all hover:bg-neutral-300 dark:hover:bg-neutral-600';
                
                const titleLink = document.createElement('a');
                titleLink.href = project.link;
                titleLink.target = "_blank";
                titleLink.innerHTML = `<strong>${project.name}</strong>`;
                
                const description = document.createElement('p');
                description.textContent = project.description;
                description.className = 'text-xs text-neutral-500 dark:text-neutral-400 mt-1';
                
                div.appendChild(titleLink);
                div.appendChild(description);
                
                PROJECTS_CONTAINER.appendChild(div);
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            initializeTheme();
            renderPersonalInfo();
            renderIdentities();
            renderSkills();
            renderProjects();
        });

        THEME_TOGGLE.addEventListener('click', () => {
            HTML_ELEMENT.classList.toggle('dark');
            const isDark = HTML_ELEMENT.classList.contains('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
            updateThemeIcon();
        });
    </script>
</body>
</html>
