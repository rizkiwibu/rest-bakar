<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rizkapis - REST API Indonesia kata nya</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: {
                            light: '#3b82f6',
                            dark: '#2563eb',
                        },
                        secondary: {
                            light: '#10b981',
                            dark: '#059669',
                        },
                        get-method: 'bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200',
                        post-method: 'bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200',
                        put-method: 'bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200',
                        delete-method: 'bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200',
                    },
                    animation: {
                        'spin-slow': 'spin 3s linear infinite',
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                    }
                }
            }
        }
    </script>
    <style>
        .gradient-text {
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            background-image: linear-gradient(to right, #3b82f6, #10b981);
        }
        
        .dark .gradient-text {
            background-image: linear-gradient(to right, #60a5fa, #34d399);
        }
        
        .endpoint-method {
            @apply px-3 py-1 rounded-md text-xs font-bold uppercase;
        }
        
        .loading-spinner {
            animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        
        pre {
            white-space: pre-wrap;
            word-wrap: break-word;
        }
        
        .api-card {
            transition: all 0.3s ease;
        }
        
        .api-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }
        
        .dark .api-card:hover {
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.25), 0 4px 6px -2px rgba(0, 0, 0, 0.1);
        }
        
        .nav-link {
            position: relative;
        }
        
        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -2px;
            left: 0;
            background-color: #3b82f6;
            transition: width 0.3s ease;
        }
        
        .nav-link:hover::after {
            width: 100%;
        }
        
        .dark .nav-link::after {
            background-color: #60a5fa;
        }
        
        .try-it-out {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-out;
        }
        
        .try-it-out.active {
            max-height: 500px;
        }
        
        .response-area {
            min-height: 100px;
        }
        
        .copy-btn {
            transition: all 0.2s ease;
        }
        
        .copy-btn:hover {
            transform: scale(1.05);
        }
        
        .copy-btn.copied {
            background-color: #10b981 !important;
        }
    </style>
</head>
