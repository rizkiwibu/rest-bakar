    <script>
        // Theme toggle
        const themeToggle = document.getElementById('theme-toggle');
        const html = document.documentElement;
        
        // Check for saved user preference or use system preference
        if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            html.classList.add('dark');
        }
        
        themeToggle.addEventListener('click', () => {
            html.classList.toggle('dark');
            localStorage.setItem('theme', html.classList.contains('dark') ? 'dark' : 'light');
        });
        
        // Mobile menu toggle
        const mobileMenuButton = document.getElementById('mobile-menu-button');
        const mobileMenu = document.getElementById('mobile-menu');
        
        mobileMenuButton.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });
        
        // Close mobile menu when clicking on a link
        document.querySelectorAll('#mobile-menu a').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });
        
        // Smooth scrolling for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                
                const targetId = this.getAttribute('href');
                const targetElement = document.querySelector(targetId);
                
                if (targetElement) {
                    targetElement.scrollIntoView({
                        behavior: 'smooth'
                    });
                }
            });
        });
        
        // Load API endpoints from the provided URL
        document.addEventListener('DOMContentLoaded', function() {
            fetch('https://restapi.rizk.my.id/docs/json')
                .then(response => response.json())
                .then(data => {
                    const loadingElement = document.getElementById('loading-endpoints');
                    if (loadingElement) {
                        loadingElement.remove();
                    }
                    
                    const apiEndpointsContainer = document.querySelector('#api-endpoints .space-y-8');
                    
                    // Process the paths from the OpenAPI/Swagger JSON
                    const paths = data.paths;
                    for (const [path, methods] of Object.entries(paths)) {
                        for (const [method, details] of Object.entries(methods)) {
                            const endpointDiv = document.createElement('div');
                            endpointDiv.className = 'api-card bg-white dark:bg-gray-800 rounded-xl shadow-md p-6 border border-gray-200 dark:border-gray-700';
                            
                            let methodColorClass = '';
                            switch(method) {
                                case 'get':
                                    methodColorClass = 'get-method';
                                    break;
                                case 'post':
                                    methodColorClass = 'post-method';
                                    break;
                                case 'put':
                                    methodColorClass = 'put-method';
                                    break;
                                case 'delete':
                                    methodColorClass = 'delete-method';
                                    break;
                                default:
                                    methodColorClass = 'text-gray-500';
                            }
                            
                            // Generate parameters form if there are parameters
                            let parametersForm = '';
                            if (details.parameters) {
                                parametersForm = details.parameters.map(param => {
                                    return `
                                        <div class="mb-4">
                                            <label class="block text-sm font-medium mb-1">${param.name} ${param.required ? '<span class="text-red-500">*</span>' : ''}</label>
                                            <input type="${param.schema?.type === 'number' ? 'number' : 'text'}" 
                                                   class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-700" 
                                                   placeholder="${param.description || param.name}" 
                                                   ${param.required ? 'required' : ''}
                                                   data-param="${param.name}">
                                        </div>
                                    `;
                                }).join('');
                            }
                            
                            endpointDiv.innerHTML = `
                                <div class="flex items-start justify-between">
                                    <div>
                                        <h4 class="text-xl font-semibold mb-2">${details.summary || 'Endpoint'}</h4>
                                        <div class="flex items-center mb-4">
                                            <span class="endpoint-method ${methodColorClass} mr-3">${method.toUpperCase()}</span>
                                            <code class="text-sm bg-gray-100 dark:bg-gray-700 px-2 py-1 rounded">${path}</code>
                                        </div>
                                        <p class="text-gray-600 dark:text-gray-300 mb-4">${details.description || 'Tidak ada deskripsi tersedia.'}</p>
                                    </div>
                                </div>
                                ${details.parameters ? `
                                <div class="mb-4">
                                    <h5 class="font-medium mb-2">Parameter:</h5>
                                    <div class="bg-gray-100 dark:bg-gray-700 p-3 rounded-lg">
                                        <table class="w-full text-sm">
                                            <thead>
                                                <tr class="text-left border-b border-gray-300 dark:border-gray-600">
                                                    <th class="pb-2">Nama</th>
                                                    <th class="pb-2">Tipe</th>
                                                    <th class="pb-2">Deskripsi</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                ${details.parameters.map(param => `
                                                    <tr class="border-b border-gray-200 dark:border-gray-600">
                                                        <td class="py-2">${param.name} ${param.required ? '<span class="text-red-500">*</span>' : ''}</td>
                                                        <td class="py-2">${param.schema?.type || param.in}</td>
                                                        <td class="py-2">${param.description || '-'}</td>
                                                    </tr>
                                                `).join('')}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                ` : ''}
                                <div>
                                    <h5 class="font-medium mb-2">Contoh Response:</h5>
                                    <div class="bg-gray-100 dark:bg-gray-700 p-3 rounded-lg overflow-x-auto">
                                        <pre class="text-sm">${JSON.stringify(details.responses?.['200']?.examples?.['application/json'] || {'message': 'Response contoh tidak tersedia'}, null, 2)}</pre>
                                    </div>
                                </div>
                                
                                <!-- Try it out section -->
                                <div class="mt-6">
                                    <button class="try-it-out-btn bg-primary-light dark:bg-primary-dark text-white px-4 py-2 rounded-md hover:opacity-90 transition-opacity">
                                        <i class="fas fa-play mr-2"></i>Coba Sekarang
                                    </button>
                                    
                                    <div class="try-it-out mt-4 bg-gray-100 dark:bg-gray-700 rounded-lg p-4">
                                        ${parametersForm ? `
                                        <div class="mb-4">
                                            <h5 class="font-medium mb-2">Masukkan Parameter:</h5>
                                            <form class="parameters-form">
                                                ${parametersForm}
                                                <button type="submit" class="bg-secondary-light dark:bg-secondary-dark text-white px-4 py-2 rounded-md hover:opacity-90 transition-opacity mt-2">
                                                    <i class="fas fa-paper-plane mr-2"></i>Kirim Request
                                                </button>
                                            </form>
                                        </div>
                                        ` : ''}
                                        
                                        <div class="response-area bg-gray-200 dark:bg-gray-800 rounded-lg p-4 mt-4">
                                            <div class="flex justify-between items-center mb-2">
                                                <h5 class="font-medium">Response:</h5>
                                                <button class="copy-btn bg-gray-300 dark:bg-gray-600 text-gray-800 dark:text-gray-200 px-2 py-1 rounded text-sm">
                                                    <i class="fas fa-copy mr-1"></i>Salin
                                                </button>
                                            </div>
                                           <pre class="response-content text-sm bg-white dark:bg-gray-900 p-3 rounded overflow-x-auto overflow-y-auto max-h-96">Klik "Kirim Request" untuk melihat response</pre>
                                        </div>
                                    </div>
                                </div>
                            `;
                            
                            apiEndpointsContainer.appendChild(endpointDiv);
                            
                            // Add event listeners for the try it out functionality
                            const tryItOutBtn = endpointDiv.querySelector('.try-it-out-btn');
                            const tryItOutSection = endpointDiv.querySelector('.try-it-out');
                            
                            tryItOutBtn.addEventListener('click', () => {
                                tryItOutSection.classList.toggle('active');
                            });
                            
                            // Handle form submission
                            const form = endpointDiv.querySelector('.parameters-form');
                            if (form) {
                                form.addEventListener('submit', function(e) {
                                    e.preventDefault();
                                    
                                    const responseContent = endpointDiv.querySelector('.response-content');
                                    const copyBtn = endpointDiv.querySelector('.copy-btn');
                                    
                                    // Build URL with parameters
                                    let apiUrl = `https://restapi.rizk.my.id${path}`;
                                    const inputs = form.querySelectorAll('input');
                                    const params = {};
                                    
                                    inputs.forEach(input => {
                                        if (input.value) {
                                            params[input.dataset.param] = input.value;
                                        }
                                    });
                                    
                                    // For GET requests, add parameters to URL
                                    if (method === 'get') {
                                        const queryParams = new URLSearchParams(params);
                                        apiUrl += `?${queryParams.toString()}`;
                                    }
                                    
                                    // Show loading state
                                    responseContent.textContent = 'Mengirim request...';
                                    
                                    // Make the API request
                                    const requestOptions = {
                                        method: method.toUpperCase(),
                                        headers: {
                                            'Content-Type': 'application/json'
                                        }
                                    };
                                    
                                    // For non-GET requests, add body
                                    if (method !== 'get') {
                                        requestOptions.body = JSON.stringify(params);
                                    }
                                    
                                    fetch(apiUrl, requestOptions)
                                        .then(response => response.json())
                                        .then(data => {
                                            responseContent.textContent = JSON.stringify(data, null, 2);
                                            copyBtn.classList.remove('copied');
                                            copyBtn.innerHTML = '<i class="fas fa-copy mr-1"></i>Salin';
                                        })
                                        .catch(error => {
                                            responseContent.textContent = `Error: ${error.message}`;
                                        });
                                });
                            }
                            
                            // Add copy functionality
                            const copyBtn = endpointDiv.querySelector('.copy-btn');
                            if (copyBtn) {
                                copyBtn.addEventListener('click', function() {
                                    const responseContent = endpointDiv.querySelector('.response-content');
                                    navigator.clipboard.writeText(responseContent.textContent)
                                        .then(() => {
                                            copyBtn.classList.add('copied');
                                            copyBtn.innerHTML = '<i class="fas fa-check mr-1"></i>Tersalin!';
                                            setTimeout(() => {
                                                copyBtn.classList.remove('copied');
                                                copyBtn.innerHTML = '<i class="fas fa-copy mr-1"></i>Salin';
                                            }, 2000);
                                        });
                                });
                            }
                        }
                    }
                    
                    // Add search functionality
                    const searchInput = document.getElementById('search-endpoint');
                    if (searchInput) {
                        searchInput.addEventListener('input', function() {
                            const searchTerm = this.value.toLowerCase();
                            const apiCards = document.querySelectorAll('.api-card');
                            
                            apiCards.forEach(card => {
                                const cardText = card.textContent.toLowerCase();
                                if (cardText.includes(searchTerm)) {
                                    card.style.display = 'block';
                                } else {
                                    card.style.display = 'none';
                                }
                            });
                        });
                    }
                })
                .catch(error => {
                    console.error('Error loading API endpoints:', error);
                    const loadingElement = document.getElementById('loading-endpoints');
                    if (loadingElement) {
                        loadingElement.innerHTML = `
                            <div class="text-red-500">
                                <i class="fas fa-exclamation-triangle text-2xl mb-2"></i>
                                <p>Gagal memuat daftar endpoint. Silakan coba lagi nanti atau kunjungi <a href="https://restapi.rizk.my.id" target="_blank" class="underline">dokumentasi lengkap</a>.</p>
                            </div>
                        `;
                    }
                });
        });
    </script>
</html>