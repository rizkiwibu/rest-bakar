<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Rizki | Rest API</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
  <link rel="icon" href="favicon-32x32.png" sizes="32x32" />

  <style>
    :root {
      --bg: #0f172a;
      --text: #f1f5f9;
      --accent: #3b82f6;
      --card: #1e293b;
      --subtext: #94a3b8;
    }

    .light {
      --bg: #f8fafc;
      --text: #0f172a;
      --accent: #2563eb;
      --card: #e2e8f0;
      --subtext: #475569;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Inter', sans-serif;
      transition: background-color 0.3s, color 0.3s;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 2rem;
    }

    .container {
      background-color: var(--card);
      padding: 2.5rem;
      border-radius: 1rem;
      text-align: center;
      max-width: 500px;
      width: 100%;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }

    .profile-img {
      width: 140px;
      border-radius: 999px;
      margin-bottom: 1.2rem;
      box-shadow: 0 0 15px var(--accent);
    }

    h1 {
      font-size: 2rem;
      margin-bottom: 0.3rem;
      color: var(--accent);
    }

    blockquote {
      font-size: 0.95rem;
      color: var(--subtext);
      margin-bottom: 1.5rem;
    }

    .button {
      display: inline-block;
      margin-top: 1.2rem;
      background-color: var(--accent);
      color: white;
      padding: 12px 24px;
      border-radius: 8px;
      font-weight: 600;
      text-decoration: none;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    }

    .button:hover {
      filter: brightness(0.95);
    }

    .contact {
      margin-top: 1.5rem;
      font-size: 0.9rem;
      color: var(--subtext);
    }

    .contact a {
      color: var(--accent);
      text-decoration: underline;
    }

    .toggle-mode {
      position: fixed;
      top: 20px;
      right: 20px;
      background: var(--card);
      color: var(--text);
      border: 2px solid var(--accent);
      padding: 8px 16px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 600;
      box-shadow: 0 3px 6px rgba(0, 0, 0, 0.3);
    }

    #loading {
      position: fixed;
      inset: 0;
      background: var(--bg);
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 9999;
    }

    .loader {
      display: flex;
      gap: 12px;
    }

    .dot {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--accent);
      animation: bounce 1s infinite;
    }

    .dot:nth-child(2) {
      animation-delay: 0.15s;
    }

    .dot:nth-child(3) {
      animation-delay: 0.3s;
    }

    @keyframes bounce {
      0%, 100% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.4);
      }
    }
  </style>
</head>

<body>
  <button class="toggle-mode" onclick="toggleMode()">Mode</button>

  <div id="loading">
    <div class="loader">
      <div class="dot"></div>
      <div class="dot"></div>
      <div class="dot"></div>
    </div>
  </div>

  <div class="container">
    <img src="https://i.pinimg.com/originals/dd/85/7a/dd857ae4600805b338a18bfae176a1c9.gif" alt="Rizki" class="profile-img" />
    <h1>rizkapiz</h1>
    <blockquote>“Never lose yourself when trying to hold on to someone who doesn't care about losing you.”</blockquote>
    <a href="/docs" class="button">Buka Dokumentasi</a>
    <p class="contact">Butuh API Key khusus? Chat <a href="https://wa.me/6285878836361">+62 858-7883-6361</a></p>
  </div>

  <script>
    window.addEventListener("load", () => {
      document.getElementById("loading").style.display = "none";
    });

    function toggleMode() {
      document.body.classList.toggle("light");
    }
  </script>
</body>

</html>
