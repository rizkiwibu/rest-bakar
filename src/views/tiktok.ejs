<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>TikTok Downloader - Rizki</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    * { box-sizing: border-box; transition: background 0.3s, color 0.3s; }
    body {
      margin: 0;
      font-family: 'Segoe UI', sans-serif;
      background: linear-gradient(to right, #1f1c2c, #928dab);
      color: #fff;
      padding: 20px;
    }
    body.light {
      background: #f4f4f4;
      color: #000;
    }
    .container {
      max-width: 600px;
      margin: auto;
      background: #2d2b3a;
      padding: 25px;
      border-radius: 10px;
      box-shadow: 0 0 15px rgba(0,0,0,0.3);
    }
    body.light .container {
      background: #fff;
      color: #000;
    }
    h1 {
      text-align: center;
      margin-bottom: 20px;
      font-size: 24px;
    }
    input {
      width: 100%;
      padding: 12px;
      border: 2px solid #00ffe0;
      border-radius: 6px;
      outline: none;
      font-size: 16px;
    }
    button {
      width: 100%;
      padding: 12px;
      margin-top: 15px;
      background: #00ffe0;
      color: #000;
      font-weight: bold;
      border: none;
      border-radius: 6px;
      cursor: pointer;
    }
    button:hover {
      background: #00c2a7;
    }
    #loading {
      margin-top: 15px;
      display: none;
    }
    .progress-bar {
      height: 5px;
      width: 0%;
      background: #00ffe0;
      border-radius: 3px;
      transition: width 0.3s;
    }
    .result {
      display: none;
      margin-top: 20px;
      background: #1e1c29;
      padding: 15px;
      border-radius: 8px;
    }
    body.light .result {
      background: #e8e8e8;
      color: #000;
    }
    video {
      width: 100%;
      margin-top: 10px;
      border-radius: 10px;
    }
    .meta { margin-top: 10px; }
    .meta p { margin: 4px 0; }
    a.download {
      display: inline-block;
      margin-top: 12px;
      background: #00ffe0;
      color: #000;
      padding: 10px 16px;
      border-radius: 6px;
      font-weight: bold;
      text-decoration: none;
    }
    a.download:hover {
      background: #00c2a7;
    }
    .history {
      margin-top: 20px;
      background: #2d2b3a;
      padding: 10px;
      border-radius: 6px;
    }
    body.light .history {
      background: #e0e0e0;
    }
    .history ul {
      list-style: none;
      padding: 0;
    }
    .history li {
      margin: 5px 0;
    }
    .toggle-theme {
      text-align: right;
      margin-bottom: 10px;
    }
    .copy-buttons button {
      margin-right: 10px;
      margin-top: 10px;
      padding: 8px 12px;
      font-size: 14px;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="toggle-theme">
      <button onclick="toggleTheme()">Ganti Tema</button>
    </div>
    <h1>TikTok Downloader by Rizki</h1>
    <input type="text" id="url" placeholder="Masukkan link TikTok">
    <button onclick="downloadVideo()">Download</button>
    <div id="loading">
      <p>Memproses video...</p>
      <div class="progress-bar" id="progressBar"></div>
    </div>
    <div class="result" id="result">
      <h3>Hasil Download:</h3>
      <img id="cover" style="width:100%;border-radius:10px;">
      <video id="video" controls></video>
      <div class="meta">
        <p><strong>Judul:</strong> <span id="title"></span></p>
        <p><strong>Musik:</strong> <span id="musicTitle"></span></p>
        <p><strong>Author Musik:</strong> <span id="musicAuthor"></span></p>
        <p><strong>Durasi Musik:</strong> <span id="duration"></span> detik</p>
        <div class="copy-buttons">
          <button onclick="copyToClipboard('link')">Salin Link</button>
        </div>
        <a class="download" id="downloadLink" target="_blank">Unduh Video</a>
      </div>
    </div>
    <div class="history" id="history">
      <h3>Riwayat Download</h3>
      <ul id="historyList"></ul>
    </div>
  </div>

  <script>
    function toggleTheme() {
      document.body.classList.toggle('light');
    }

    function copyToClipboard(type) {
      let text = '';
      if (type === 'link') text = document.getElementById('downloadLink').href;
      navigator.clipboard.writeText(text)
        .then(() => alert('Tersalin ke clipboard!'))
        .catch(() => alert('Gagal menyalin.'));
    }

    async function downloadVideo() {
      const url = document.getElementById('url').value.trim();
      const loading = document.getElementById('loading');
      const result = document.getElementById('result');
      const progressBar = document.getElementById('progressBar');

      result.style.display = 'none';
      loading.style.display = 'block';
      progressBar.style.width = '20%';

      if (!url || !url.includes('tiktok.com')) {
        loading.style.display = 'none';
        return alert('Masukkan link TikTok yang valid.');
      }

      try {
        const res = await fetch(`https://restapi.rizk.my.id/downloader/tiktok?url=${encodeURIComponent(url)}`);
        progressBar.style.width = '60%';
        const json = await res.json();
        progressBar.style.width = '90%';

        if (json.status !== 'success') throw new Error(json.message || 'Gagal mengambil data.');

        const data = json.data;

        document.getElementById('cover').src = data.cover;
        document.getElementById('video').src = data.play_url;
        document.getElementById('title').innerText = data.title || '-';
        document.getElementById('musicTitle').innerText = data.music_info?.title || '-';
        document.getElementById('musicAuthor').innerText = data.music_info?.author || '-';
        document.getElementById('duration').innerText = data.music_info?.duration || '-';
        document.getElementById('downloadLink').href = data.play_url;

        result.style.display = 'block';
        progressBar.style.width = '100%';
        loading.style.display = 'none';

        addToHistory(url);
      } catch (err) {
        loading.style.display = 'none';
        alert('Gagal memproses video: ' + err.message);
      }
    }

    function addToHistory(link) {
      const ul = document.getElementById('historyList');
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = link;
      a.textContent = link;
      a.target = '_blank';
      li.appendChild(a);
      ul.prepend(li);
    }
  </script>
</body>
</html>
