const axios = require("axios");
const validateApiKey = require("../../middlewares/validateApiKey"); // Import middleware

/**
 * @swagger
 * tags:
 *   name: OpenAI
 *   description: API untuk mendapatkan respons dari AI Rieltem
 */

module.exports = async (fastify) => {
    /**
     * @swagger
     * /aiRieltem:
     *   get:
     *     summary: Mendapatkan jawaban dari AI Rieltem
     *     tags: [OpenAI]
     *     parameters:
     *       - name: query
     *         in: query
     *         required: true
     *         description: Pertanyaan yang akan diajukan ke AI
     *         schema:
     *           type: string
     *       - name: apikey
     *         in: query
     *         required: true
     *         description: API key untuk autentikasi
     *         schema:
     *           type: string
     *     responses:
     *       200:
     *         description: Berhasil mendapatkan jawaban dari AI
     *       403:
     *         description: API key tidak valid
     *       400:
     *         description: Query tidak boleh kosong
     *       500:
     *         description: Terjadi kesalahan server
     */
    fastify.get("/aiRieltem", { preHandler: validateApiKey }, async (req, reply) => {
        const { query } = req.query;

        if (!query) {
            return reply.code(400).send({
                status: "error",
                message: "Query tidak boleh kosong!"
            });
        }

        try {
            const result = await aiRieltem(query);
            return reply.code(200).send(result);
        } catch (error) {
            return reply.code(500).send({
                status: "error",
                message: error.message
            });
        }
    });
};

// Fungsi untuk scraping AI Rieltem
async function aiRieltem(text) {
    let payload = {
        messages: [{
            content: text,
            role: "user"
        }]
    };

    try {
        let { data } = await axios.post("https://ai.riple.org/", payload, {
            headers: {
                "Content-Type": "application/json",
                "Accept": "application/json",
                "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
            },
            responseType: "stream"
        });

        return new Promise((resolve, reject) => {
            let fullResponse = "";

            data.on("data", (chunk) => {
                let lines = chunk.toString().split("\n");

                for (let line of lines) {
                    if (line.startsWith("data: ")) {
                        let jsonString = line.slice(6).trim();

                        if (jsonString === "[DONE]") {
                            return resolve({ result: fullResponse.trim() });
                        }

                        try {
                            let parsedData = JSON.parse(jsonString);
                            let content = parsedData?.choices?.[0]?.delta?.content;

                            if (content) {
                                fullResponse += content;
                            }
                        } catch (err) {
                            reject(err);
                        }
                    }
                }
            });

            data.on("error", (err) => reject(err));
        });

    } catch (error) {
        throw new Error(error.message);
    }
}
