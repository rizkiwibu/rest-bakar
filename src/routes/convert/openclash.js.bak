const axios = require("axios");
const yaml = require("js-yaml");
const validateApiKey = require("../../middlewares/validateApiKey");
const { Buffer } = require("buffer");

/**
 * @swagger
 * tags:
 *   - name: OpenClashConverter
 *     description: API untuk mengonversi VMess/Trojan ke format OpenClash YAML
 */

module.exports = async (fastify) => {
    /**
     * @swagger
     * /convert/openclash:
     *   get:
     *     summary: Konversi VMess/Trojan ke OpenClash YAML
     *     tags:
     *       - OpenClashConverter
     *     parameters:
     *       - name: input
     *         in: query
     *         required: true
     *         description: Link VMess atau Trojan
     *         schema:
     *           type: string
     *           example: "vmess://eyJhZGQiOiIxMDQuMTguMi4yIiwiYWlkIjoiMCIs..."
     *       - name: apikey
     *         in: query
     *         required: true
     *         description: API key untuk autentikasi
     *         schema:
     *           type: string
     *     responses:
     *       200:
     *         description: Berhasil mengonversi ke format OpenClash YAML
     *       403:
     *         description: API key tidak valid
     *       400:
     *         description: Parameter tidak boleh kosong atau format salah
     *       500:
     *         description: Terjadi kesalahan server
     */
    fastify.get("/convert/openclash", { preHandler: validateApiKey }, async (req, reply) => {
        const { input } = req.query;

        if (!input) {
            return reply.code(400).send({
                status: "error",
                message: "Parameter 'input' tidak boleh kosong!"
            });
        }

        let proxyConfig = null;

        // Deteksi apakah formatnya VMess atau Trojan
        if (input.startsWith("vmess://")) {
            try {
                const base64Data = input.replace("vmess://", "");
                const decodedData = JSON.parse(Buffer.from(base64Data, "base64").toString("utf-8"));

                proxyConfig = {
                    name: decodedData.ps || "VMess Node",
                    server: decodedData.add,
                    port: parseInt(decodedData.port),
                    type: "vmess",
                    uuid: decodedData.id,
                    alterId: decodedData.aid || 0,
                    cipher: decodedData.scy || "auto",
                    network: decodedData.net || "ws",
                    tls: decodedData.tls === "tls",
                    sni: decodedData.sni || decodedData.host || "",
                    ws_opts: {
                        path: decodedData.path || "/",
                        headers: { Host: decodedData.host || "" }
                    },
                    udp: true
                };
            } catch (error) {
                return reply.code(400).send({
                    status: "error",
                    message: "Format VMess tidak valid!"
                });
            }
        } else if (input.startsWith("trojan://")) {
            try {
                const regex = /trojan:\/\/(.*?):(.*?)@(.*?):(\d+)\?(.*?)#(.*)/;
                const match = input.match(regex);

                if (!match) {
                    return reply.code(400).send({
                        status: "error",
                        message: "Format Trojan tidak valid!"
                    });
                }

                const [, password, , server, port, query, name] = match;
                const params = new URLSearchParams(query);

                const trojanURL = `trojan://${password}@${server}:${port}?path=${encodeURIComponent(params.get("path") || "/trojan")}&security=${params.get("security") || "tls"}&host=${params.get("host") || params.get("sni") || server}&type=${params.get("type") || "ws"}&sni=${params.get("sni") || server}#${name}`;

                proxyConfig = {
                    name: decodeURIComponent(name),
                    server,
                    port: parseInt(port),
                    type: "trojan",
                    password,
                    skip_cert_verify: true,
                    sni: params.get("sni") || params.get("host") || server,
                    network: params.get("type") || "ws",
                    ws_opts: {
                        path: params.get("path") || "/",
                        headers: { Host: params.get("sni") || params.get("host") || server }
                    },
                    udp: true,
                    trojan_url: trojanURL // Masukkan URL Trojan yang benar
                };
            } catch (error) {
                return reply.code(400).send({
                    status: "error",
                    message: "Format Trojan tidak valid!"
                });
            }
        } else {
            return reply.code(400).send({
                status: "error",
                message: "Format input tidak dikenali! Harus VMess atau Trojan."
            });
        }

        // Format OpenClash YAML
        const openClashConfig = {
            port: 7890,
            socks_port: 7891,
            redir_port: 7892,
            mixed_port: 7893,
            tproxy_port: 7895,
            ipv6: false,
            mode: "rule",
            log_level: "silent",
            allow_lan: true,
            external_controller: "0.0.0.0:9090",
            secret: "",
            bind_address: "*",
            unified_delay: true,
            profile: {
                store_selected: true
            },
            dns: {
                enable: true,
                ipv6: false,
                enhanced_mode: "redir-host",
                listen: "0.0.0.0:7874",
                nameserver: [
                    "8.8.8.8",
                    "1.0.0.1",
                    "https://dns.google/dns-query"
                ],
                fallback: [
                    "1.1.1.1",
                    "8.8.4.4",
                    "https://cloudflare-dns.com/dns-query",
                    "112.215.203.254"
                ],
                default_nameserver: [
                    "8.8.8.8",
                    "1.1.1.1",
                    "112.215.203.254"
                ]
            },
            proxies: [proxyConfig],
            proxy_groups: [
                {
                    name: "FASTSSH-SSHKIT-HOWDY",
                    type: "select",
                    proxies: [proxyConfig.name, "DIRECT"]
                }
            ],
            rules: ["MATCH,FASTSSH-SSHKIT-HOWDY"]
        };

        const yamlData = yaml.dump(openClashConfig);

        return reply.header("Content-Type", "text/yaml").send(yamlData);
    });
};
